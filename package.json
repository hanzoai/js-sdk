{
  "name": "hanzoai",
  "version": "8.5.156",
  "description": "The official TypeScript library for the Hanzo API",
  "author": "Hanzo <dev@hanzo.ai>",
  "license": "Apache-2.0",
  "repository": "github:hanzoai/js-sdk",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit",
    "examples": "tsc -p examples/tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && npm run smoke && npm run examples",
    "generate": "./scripts/generate.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  }
}
